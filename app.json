{
  "expo": {
    "name": "My Tech Portail",
    "slug": "my-tech-service",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mytechservice",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1f3d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.mytechnologie.mytechservice",
      "buildNumber": "41",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "L'application utilise la caméra pour photographier le travail et lire l'étiquette des appareils."
      }
    },
    "android": {
      "package": "ca.mytechnologie.mytechservice",
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1f3d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a1f3d"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "La caméra sert à photographier le travail effectué sur les bons de travail.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0a1f3d"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à photographier le travail et à lire l'étiquette des appareils installés.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ae2eb9a-6931-4198-a7d8-a61a1c1a9998"
      }
    },
    "owner": "yanaubin",
    "updates": {
      "url": "https://u.expo.dev/9ae2eb9a-6931-4198-a7d8-a61a1c1a9998"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
