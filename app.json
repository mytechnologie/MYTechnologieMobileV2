{
  "expo": {
    "name": "My Tech Portail",
    "slug": "my-tech-service",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mytechservice",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1f3d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.mytechnologie.mytechservice",
      "buildNumber": "36",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "L'application utilise la caméra pour prendre des photos avant/après sur un bon de travail.",
        "NSPhotoLibraryUsageDescription": "L'application accède à vos photos pour joindre des images à un bon de travail."
      }
    },
    "android": {
      "package": "ca.mytechnologie.mytechservice",
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1f3d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a1f3d"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour joindre des images à un bon de travail.",
          "cameraPermission": "L'application utilise la caméra pour prendre des photos avant/après sur un bon de travail."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ae2eb9a-6931-4198-a7d8-a61a1c1a9998"
      }
    },
    "owner": "yanaubin"
  }
}
